{
  "name": "mykitchen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "vite": "vite",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "clean:duplicates": "node scripts/clean-duplicates.js",
    "android:build": "bash scripts/setup-android.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@types/express": "^5.0.6",
    "canvas": "^3.2.3",
    "dompurify": "^3.3.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4",
    "wrangler": "^4.79.0"
  }
}
